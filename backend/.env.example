# Sentinelle backend configuration — copy to .env and adjust.

# Async SQLAlchemy URL. Defaults to local SQLite; Postgres also supported, e.g.:
# DATABASE_URL=postgresql+asyncpg://sentinelle:sentinelle@localhost:5432/sentinelle
DATABASE_URL=sqlite+aiosqlite:///./sentinelle.db

# Redis for the arq scan queue
REDIS_URL=redis://localhost:6379

# JWT signing — CHANGE THIS in any real deployment
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=60

ENV=dev

# v0.2 — optional NVD API key (higher rate limits for CVE enrichment; works without it)
# NVD_API_KEY=

# --- v0.3 Defensive features -------------------------------------------------
# Suricata EVE JSON stream tailed by the worker's ingest job (#1).
SURICATA_EVE_PATH=/var/log/suricata/eve.json

# Declarative detection rules (#2). Empty -> the packaged backend/rules/detection.yaml.
# DETECTION_RULES_PATH=./rules/detection.yaml

# Days of findings / alerts / sensor events kept before the daily purge (#5).
# <= 0 disables purging (keep everything — useful for a demo instance).
RETENTION_DAYS=90

# Safety cap on the sliding window the detection engine pulls back from the DB.
DETECTION_WINDOW_MAX_EVENTS=5000

# --- v0.4 Threat intel -------------------------------------------------------
# MISP pull connector (#6). Both values are required; unset -> job skipped.
# MISP_URL=https://misp.example.org
# MISP_API_KEY=
MISP_LOOKBACK_DAYS=30
MISP_ATTRIBUTE_LIMIT=500

# AlienVault OTX (#7). Unset -> job skipped. Never hard-coded.
# OTX_API_KEY=
OTX_PULSE_LIMIT=20

# CERT advisory feeds (#8), "NAME=URL" entries separated by commas.
CERT_FEEDS=CERT-FR=https://www.cert.ssi.gouv.fr/feed/
CERT_ITEMS_PER_FEED=50

# Bound on the indicators considered by one correlation run (#9).
INTEL_IOC_LIMIT=1000

# --- v0.5 Governance & reporting (#12-#15) -----------------------------------
# Where the browser is sent back after an SSO login (the SPA).
FRONTEND_URL=http://localhost:5173

# OIDC / Keycloak single sign-on (#14). All three of the first values are
# required to enable SSO; without them the local password login stays the only
# path and the SSO button is hidden.
# OIDC_ISSUER=http://localhost:8081/realms/sentinelle
# OIDC_CLIENT_ID=sentinelle
# OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/api/auth/oidc/callback
OIDC_SCOPES=openid profile email
OIDC_ROLE_CLAIM=realm_access.roles
OIDC_ADMIN_ROLES=sentinelle-admin,admin
OIDC_ANALYST_ROLES=sentinelle-analyst,analyst
OIDC_DEFAULT_ROLE=viewer
