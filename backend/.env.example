# Sentinelle backend configuration — copy to .env and adjust.

# Async SQLAlchemy URL. Defaults to local SQLite; Postgres also supported, e.g.:
# DATABASE_URL=postgresql+asyncpg://sentinelle:sentinelle@localhost:5432/sentinelle
DATABASE_URL=sqlite+aiosqlite:///./sentinelle.db

# Redis for the arq scan queue
REDIS_URL=redis://localhost:6379

# JWT signing — CHANGE THIS in any real deployment
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=60

ENV=dev

# v0.2 — optional NVD API key (higher rate limits for CVE enrichment; works without it)
# NVD_API_KEY=
